<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SingleBrowserSuite">

	<listeners>

		<!-- Allure TestNG integration -->
		<listener class-name="io.qameta.allure.testng.AllureTestNg" />

		<!-- Framework listener -->
		<listener class-name="listeners.FrameworkListener" />

		<!-- Extent Report -->
		<listener class-name="listeners.ExtentSuiteListener" />

		<!-- Allure result management -->
		<listener class-name="listeners.AllureSuiteListener" />

		<!-- Retry -->
		<listener class-name="listeners.RetryTransformer" />

	</listeners>

	<test name="Functional Test">

		<classes>

			<class name="tests.KeywordDrivenTest" />

			<!-- <class name="tests.KeywordDrivenTest2"/> -->

		</classes>

	</test>

</suite>



